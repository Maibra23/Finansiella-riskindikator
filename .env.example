# ============================================================
# KRI Dashboard – Environment Variables
# ============================================================
# Copy this file to .env and fill in any values you need.
# The dashboard works without any variables in default mode
# (all data is fetched from public APIs with no authentication).
# ============================================================

# Optional: override the SCB API base URL (leave blank for default)
SCB_API_BASE=

# Optional: override the Kolada API base URL (leave blank for default)
KOLADA_API_BASE=

# Optional: set cache directory (default: data/cache/)
KRI_CACHE_DIR=

# Optional: disable API caching entirely (set to "1" to disable)
KRI_NO_CACHE=
